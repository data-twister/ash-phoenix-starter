<!DOCTYPE html>
<html lang="en">
  <head phx-update="stream" id="head">
    <%= if tags = Application.get_env(:live_debugger, :live_debugger_tags) do %>
      {raw(tags)}
    <% end %>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <SEO.juice
      conn={@conn}
      config={AshPhoenixStarterWeb.SEO.config()}
      page_title={assigns[:page_title]}
    />

    <AshPhoenixStarterWeb.Map.assets />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/images/icons/icons.css"} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <link
      id="favicon-32"
      rel="icon"
      type="image/png"
      data-dynamic-href="/images/favicons/{subfolder}/favicon-32x32.png"
      href={~p"/images/favicons/favicon-32x32.png"}
    />
    <link
      id="favicon-16"
      rel="icon"
      type="image/png"
      data-dynamic-href="/images/favicons/{subfolder}/favicon-16x16.png"
      href={~p"/images/favicons/favicon-16x16.png"}
    />

    <link
      id="dynamic-svg-favicon"
      rel="icon"
      type="image/svg+xml"
    />

    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        setTheme(localStorage.getItem("phx:theme") || "system");
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    <%= if Plug.Conn.get_session(@conn, :impersonator_user_id) && assigns[:current_user] do %>
      <div class="bg-yellow-400 text-neutral-900 font-semibold text-center py-2.5 px-4 text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 relative z-50 sticky top-0 shadow-md border-b border-yellow-500">
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="shrink-0 text-base">⚠️</span>
          <p class="truncate">
            <strong>Impersonation Mode:</strong>
            Viewing as <span class="underline font-bold">{assigns[:current_user].email}</span>
          </p>
        </div>
        <a
          href="/accounts/users/stop/impersonation"
          class="w-full sm:w-auto shrink-0 text-center bg-neutral-900 text-white hover:bg-neutral-800 active:scale-95 transition-all text-xs font-bold py-1.5 sm:py-1 px-4 rounded shadow-sm"
        >
          Exit Session
        </a>
      </div>
    <% end %>
    {@inner_content}
  </body>
</html>
